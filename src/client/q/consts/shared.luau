-- Luau port of the constants of q_shared.h, surfaceflags.h, tr_types.h, bg_public.h, cg_public.h and challenges.h (OpenArena gamecode).

local t: { [string]: any } = {}

-- Adds enum members numbered from 0 (or from an explicit {name, value}) and
-- the enum's count member "<typeName>_COUNT" (last value + 1).
local function enum(typeName: string, members: { any })
	local v = 0
	for _, m in members do
		if type(m) == "table" then
			v = m[2]
			t[m[1]] = v
		else
			t[m] = v
		end
		v += 1
	end
	t[typeName .. "_COUNT"] = v
end

