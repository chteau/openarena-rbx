local shared = require(script.Parent.shared)

local C = {}

local function enum(start: number, names: string)
	local v = start
	local pos = 1
	while true do
		local s, e = string.find(names, "%S+", pos)
		if s == nil then
			break
		end
		C[string.sub(names, s, e)] = v
		v += 1
		pos = e + 1
	end
end

local function numbered(prefix: string, first: number, last: number, start: number): number
	local v = start
	for i = first, last do
		C[prefix .. i] = v
		v += 1
	end
	return v
end

