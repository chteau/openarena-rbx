--!native
-- Every #define / enum the bot AI sees: the game module's (g_defs) plus
-- the bot headers' (ai_consts, generated by tools/gen_bot_defs.py), so
-- ported ai_*.c code writes C.NAME for any of them.

local C = {}
for k, v in require("../g_defs") do
	C[k] = v
end
for k, v in require("./ai_consts") do
	C[k] = v
end
table.freeze(C)
return C
