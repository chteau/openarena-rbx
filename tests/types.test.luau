local okS, T = pcall(H.require, "client/q/types/shared")
H.test("types.shared", function()
	assert(okS, T)
	local es = T.entityState_t()
	H.eq(es.pos.trBase[0], 0)
	H.eq(es.pos.trBase[2], 0)
	local ps = T.playerState_t()
	H.eq(ps.stats[0], 0)
	H.eq(ps.ammo[0], 0)
	H.eq(ps.viewangles[1], 0)
	local re = T.refEntity_t()
	H.eq(re.axis[2][2], 0)
	H.eq(re.shaderRGBA[3], 0)
	local copy = T.copy(es)
	copy.pos.trBase[0] = 5
	H.eq(es.pos.trBase[0], 0)
	T.assign(es, copy)
	H.eq(es.pos.trBase[0], 5)
	T.reset(es, T.entityState_t)
	H.eq(es.pos.trBase[0], 0)
	local rd = T.refdef_t()
	H.eq(rd.vieworg[0], 0)
	H.eq(T.vmCvar_t().string, "")
end)
local okC, Tcg = pcall(H.require, "client/q/types/cg")
if okC then
	H.test("types.cg", function()
		local cent = Tcg.centity_t()
		H.eq(cent.currentState.pos.trBase[0], 0)
		H.eq(cent.lerpOrigin[1], 0)
		H.eq(cent.pe.legs.frame, 0)
		local cg = Tcg.cg_t()
		H.eq(cg.refdef.vieworg[0], 0)
		H.eq(cg.predictedPlayerState.stats[0], 0)
		local cgs = Tcg.cgs_t()
		H.eq(cgs.clientinfo[63].infoValid, false)
		H.eq(cgs.media.charsetShader, 0)
		local ci = Tcg.clientInfo_t()
		H.eq(ci.animations[0].firstFrame, 0)
	end)
end
